#!/usr/bin/env bash
#MISE description="The push gate: CI's checks and tests on a commit (HEAD by default) in a clean worktree, as the pre-push hook runs them before a push to main; on the build Mac, or here when it doesn't answer (scripts/build-mac.py gate)"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
exec scripts/build-mac.py gate "$@"
